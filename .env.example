# Default standalone example
BOT_RUNTIME_ROLE=standalone
INTERNAL_PROVIDER_MODE=package
INTERNAL_PROVIDER_PACKAGE=financial-bot-internal

# Runtime root overrides
# BOT_RUNTIME_ROOT_DIR=/absolute/path/to/runtime
# BOT_DATA_DIR=/absolute/path/to/runtime/data
# BOT_RUNS_DIR=/absolute/path/to/runtime/runs
# BOT_BENCHMARK_DIR=/absolute/path/to/runtime/benchmark
# BOT_CHARTS_DIR=/absolute/path/to/runtime/charts

# Collector
# COLLECTOR_TASKS=sync-market-reference,collect-market-facts,collect-market-prices,build-market-read-model,purge-app-retention,purge-runtime-files
# COLLECTOR_INTERVAL_MS=3600000
# COLLECTOR_RUN_ON_START=true
# MARKET_PIPELINE_DB_PATH=/absolute/path/to/runtime/data/market_pipeline.sqlite3
# MARKET_REFERENCE_DB_PATH=/absolute/path/to/runtime/data/market_reference.sqlite3
# MARKET_READ_MODEL_DB_PATH=/absolute/path/to/runtime/data/market_read_model.sqlite3
# MARKET_REPLICA_STATUS_PATH=/absolute/path/to/runtime/data/market_replica_manifest.json
# SEC_USER_AGENT=Your Organization data@example.com
# MARKET_COLLECTION_BATCH_SIZE=250
# GDELT_BROAD_INDUSTRY_CANDIDATE_LIMIT=3
# RETENTION_PAYMENT_EVENT_DAYS=1825
# RETENTION_PAYMENT_EVENT_REVISION_DAYS=1825
# RETENTION_INACTIVE_SUBSCRIPTION_DAYS=1825
# RETENTION_EXPIRED_CLAIM_DAYS=30
# RETENTION_EXPIRED_REPORT_CACHE_GRACE_DAYS=7
# RETENTION_RATE_LIMIT_DAYS=7
# RETENTION_REPORT_QUOTA_USAGE_MONTHS=15
# RETENTION_REPORT_ARTIFACT_DAYS=365
# RETENTION_REPORT_JOB_PROCESSED_DAYS=365
# RETENTION_RAW_LOG_DAYS=30

DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
BENCHMARK_INITIAL_CASH=10000
BENCHMARK_BUY_FEE_RATE=0.001
BENCHMARK_SELL_FEE_RATE=0.001
GUMROAD_PERSONAL_PRODUCT_URL=https://yeongkun.gumroad.com/l/cyekst
GUMROAD_GUILD_PRODUCT_URL=
GUMROAD_CLAIM_FIELD_NAME=ClaimCode
GUMROAD_PING_ENABLED=false
GUMROAD_PING_HOST=0.0.0.0
GUMROAD_PING_PORT=8787
GUMROAD_PING_PATH=/gumroad/ping
# Required whenever GUMROAD_PING_ENABLED=true.
GUMROAD_PING_SECRET=
GUMROAD_PUBLIC_BASE_URL=
GUMROAD_OAUTH_APPLICATION_ID=
GUMROAD_OAUTH_ACCESS_TOKEN=
GUMROAD_OAUTH_APPLICATION_SECRET=
GUMROAD_RESOURCE_SUBSCRIPTIONS_ENABLED=false
GUMROAD_RESOURCE_SUBSCRIPTION_RESOURCES=sale,refund,cancellation,subscription_ended
# GUMROAD_TUNNEL_ENABLED=true
# GUMROAD_TUNNEL_DESTINATION=nokey@localhost.run
# GUMROAD_TUNNEL_REMOTE_PORT=80
# GUMROAD_TUNNEL_LOCAL_HOST=127.0.0.1
# GUMROAD_TUNNEL_LOCAL_PORT=8787
GUMROAD_TIER_MAP_JSON={\"basic\":\"individual_basic\",\"server basic\":\"guild_basic\"}
ALLOWED_DISCORD_USER_IDS=

# Codex CLI execution profiles from ~/.codex/config.toml.
# These should stay set so report stages use explicit profiles instead of model/reasoning fallbacks.
CODEX_PROFILE=default
CODEX_GUARD_PROFILE=fast-guard
CODEX_BENCHMARK_PROFILE=deep-benchmark
# AUTO_REPORT_ENABLED=false
# AUTO_REPORT_GUILD_ID=
# AUTO_REPORT_CHANNEL_ID=
# AUTO_REPORT_IDLE_MS=7200000
# AUTO_REPORT_CHECK_INTERVAL_MS=60000
# AUTO_REPORT_WAIT_TIMEOUT_MS=1200000
# AUTO_REPORT_SKILL=druckenmiller-market-research
# AUTO_REPORT_QUESTION=현재 글로벌 시장에서 가장 중요한 레짐 변화와 기대수익 비대칭이 큰 산업/종목을 드러켄밀러 스타일로 정리해줘.
# CHART_RENDER_CONCURRENCY=4
# REPORT_CHART_FILTER_ENABLED=true
# REPORT_CHART_FILTER_PROFILE=short-pressure-stack
# REPORT_CHART_FILTER_TIMEFRAMES=D
