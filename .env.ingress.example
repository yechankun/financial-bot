BOT_RUNTIME_ROLE=ingress
INTERNAL_PROVIDER_MODE=package
INTERNAL_PROVIDER_PACKAGE=financial-bot-internal

# Public repo root stays the process cwd.
# Runtime root is where synced runtime state lives on the server.
# This process handles Discord only. Run payment-webhook separately.
BOT_RUNTIME_ROOT_DIR=/srv/financial-bot-runtime
BOT_DATA_DIR=/srv/financial-bot-runtime/data
# Set to the verified current replica produced by ops/rsync-etf-v1.example.sh.
ETF_DIRECT_DATA_DIR=/srv/financial-bot-runtime/data/etf-replica/current
BOT_RUNS_DIR=/srv/financial-bot-runtime/runs
BOT_BENCHMARK_DIR=/srv/financial-bot-runtime/benchmark
BOT_CHARTS_DIR=/srv/financial-bot-runtime/charts

DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
BENCHMARK_INITIAL_CASH=10000
BENCHMARK_BUY_FEE_RATE=0.001
BENCHMARK_SELL_FEE_RATE=0.001
CODEX_PROFILE=default
CODEX_GUARD_PROFILE=fast-guard
CODEX_BENCHMARK_PROFILE=deep-benchmark
AUTO_REPORT_ENABLED=false
AUTO_REPORT_GUILD_ID=
AUTO_REPORT_CHANNEL_ID=
AUTO_REPORT_IDLE_MS=7200000
AUTO_REPORT_CHECK_INTERVAL_MS=60000
AUTO_REPORT_WAIT_TIMEOUT_MS=1200000
AUTO_REPORT_SKILL=druckenmiller-market-research
AUTO_REPORT_QUESTION=현재 글로벌 시장에서 가장 중요한 레짐 변화와 기대수익 비대칭이 큰 산업/종목을 드러켄밀러 스타일로 정리해줘.
GUMROAD_PERSONAL_PRODUCT_URL=https://yeongkun.gumroad.com/l/cyekst
GUMROAD_GUILD_PRODUCT_URL=
GUMROAD_CLAIM_FIELD_NAME=ClaimCode
GUMROAD_PING_ENABLED=false
GUMROAD_PING_HOST=0.0.0.0
GUMROAD_PING_PORT=8787
GUMROAD_PING_PATH=/gumroad/ping
GUMROAD_PING_SECRET=
GUMROAD_TIER_MAP_JSON={\"basic\":\"individual_basic\",\"server basic\":\"guild_basic\"}
ALLOWED_DISCORD_USER_IDS=
