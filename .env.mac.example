BOT_RUNTIME_ROLE=worker
INTERNAL_PROVIDER_MODE=package
INTERNAL_PROVIDER_PACKAGE=../financial-bot-internal/src/index.js

COLLECTOR_TASKS=sync-market-reference,collect-market-facts,collect-market-prices,build-market-read-model,purge-app-retention,purge-runtime-files
COLLECTOR_INTERVAL_MS=3600000
COLLECTOR_RUN_ON_START=true
RETENTION_PAYMENT_EVENT_DAYS=1825
RETENTION_PAYMENT_EVENT_REVISION_DAYS=1825
RETENTION_INACTIVE_SUBSCRIPTION_DAYS=1825
RETENTION_EXPIRED_CLAIM_DAYS=30
RETENTION_EXPIRED_REPORT_CACHE_GRACE_DAYS=7
RETENTION_RATE_LIMIT_DAYS=7
RETENTION_REPORT_QUOTA_USAGE_MONTHS=15
RETENTION_REPORT_ARTIFACT_DAYS=365
RETENTION_REPORT_JOB_PROCESSED_DAYS=365
RETENTION_RAW_LOG_DAYS=30

# Public repo root stays the process cwd.
# Runtime root is where the Mac worker keeps its writable runtime state.
BOT_RUNTIME_ROOT_DIR=/Users/yechankun/Runtime/financial-bot-worker
BOT_DATA_DIR=/Users/yechankun/Runtime/financial-bot-worker/data
BOT_RUNS_DIR=/Users/yechankun/Runtime/financial-bot-worker/runs
BOT_BENCHMARK_DIR=/Users/yechankun/Runtime/financial-bot-worker/benchmark
BOT_CHARTS_DIR=/Users/yechankun/Runtime/financial-bot-worker/charts

# Internal package uses the same public repo for schemas/config,
# but writes runtime state under INTERNAL_RUNTIME_ROOT_DIR.
INTERNAL_WORKSPACE_DIR=/Users/yechankun/Code/bots/financial-bot
INTERNAL_RUNTIME_ROOT_DIR=/Users/yechankun/Runtime/financial-bot-worker
INTERNAL_DATA_DIR=/Users/yechankun/Runtime/financial-bot-worker/data
INTERNAL_RUNS_DIR=/Users/yechankun/Runtime/financial-bot-worker/runs
INTERNAL_BENCHMARK_DIR=/Users/yechankun/Runtime/financial-bot-worker/benchmark
INTERNAL_CHARTS_DIR=/Users/yechankun/Runtime/financial-bot-worker/charts
MARKET_PIPELINE_DB_PATH=/Users/yechankun/Runtime/financial-bot-worker/data/market_pipeline.sqlite3
MARKET_REFERENCE_DB_PATH=/Users/yechankun/Runtime/financial-bot-worker/data/market_reference.sqlite3
MARKET_READ_MODEL_DB_PATH=/Users/yechankun/Runtime/financial-bot-worker/data/market_read_model.sqlite3
# SEC_USER_AGENT=Your Organization data@example.com
MARKET_COLLECTION_BATCH_SIZE=250

# Discord credentials are not required on the Mac worker unless you also run ingress there.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
BENCHMARK_INITIAL_CASH=10000
BENCHMARK_BUY_FEE_RATE=0.001
BENCHMARK_SELL_FEE_RATE=0.001
GUMROAD_PERSONAL_PRODUCT_URL=https://yeongkun.gumroad.com/l/cyekst
GUMROAD_GUILD_PRODUCT_URL=
GUMROAD_CLAIM_FIELD_NAME=ClaimCode
GUMROAD_TIER_MAP_JSON={\"basic\":\"individual_basic\",\"server basic\":\"guild_basic\"}
ALLOWED_DISCORD_USER_IDS=

CODEX_BIN=codex
CODEX_PROFILE=default
CODEX_GUARD_PROFILE=fast-guard
CODEX_BENCHMARK_PROFILE=deep-benchmark
CHART_RENDER_CONCURRENCY=4
REPORT_CHART_FILTER_ENABLED=true
REPORT_CHART_FILTER_PROFILE=short-pressure-stack
REPORT_CHART_FILTER_TIMEFRAMES=D
