//@version=6
indicator(title="Rolling Short Pressure Oscillator (Sochan)", shorttitle="Sochan RollShort", overlay=false, max_bars_back=5000)

enable_split_adjustment = input.bool(true, "Enable Split Adjustment", group="Split Adjustment")

priceType  = input.string("Close", "Price Source",
     options=["Close", "Open", "High", "Low", "HL2", "HLC3", "OHLC4"], group="Source",
     tooltip="공매도 거래대금 계산에 적용되는 가격 소스")

rollLen = input.int(5, "Rolling Accumulation Length", minval=1, group="Source",
     tooltip="최근 N봉의 공매도 거래대금을 누적합합니다.")

preSmoothLength = input.int(3, "Pre-Smoothing Length", minval=1, group="Source",
     tooltip="롤링 누적값에 추가 SMA를 적용합니다. 1 = 사용 안 함")

oscType      = input.string("Percentile Rank", "Oscillator Type",
     options=["Percentile Rank", "Stoch Range"], group="Oscillator")
lookback     = input.int(70, "Oscillator Lookback", minval=10, group="Oscillator")
signalType   = input.string("None", "Signal Type", options=["None", "SMA", "EMA"], group="Oscillator")
signalLength = input.int(5, "Signal Length", minval=1, group="Oscillator")

upperExtreme = input.float(90.0, "Extreme Overheat", minval=50.0, maxval=100.0, group="Oscillator")
upperLevel   = input.float(70.0, "Overheat", minval=50.0, maxval=100.0, group="Oscillator")
lowerLevel   = input.float(30.0, "Shrinkage", minval=0.0, maxval=50.0, group="Oscillator")
lowerExtreme = input.float(10.0, "Extreme Shrinkage", minval=0.0, maxval=50.0, group="Oscillator")

short_ticker = "FINRA:" + syminfo.ticker + "_SHORT_VOLUME"

f_price() =>
    switch priceType
        "Close"  => close
        "Open"   => open
        "High"   => high
        "Low"    => low
        "HL2"    => hl2
        "HLC3"   => hlc3
        "OHLC4"  => ohlc4
        => close

priceSrc = f_price()

useDailyAgg = timeframe.in_seconds(timeframe.period) > timeframe.in_seconds("1D")

split_numerator   = request.splits(syminfo.tickerid, splits.numerator, barmerge.gaps_on, ignore_invalid_symbol=true)
split_denominator = request.splits(syminfo.tickerid, splits.denominator, barmerge.gaps_on, ignore_invalid_symbol=true)
split_ratio = not na(split_numerator) and not na(split_denominator) and split_numerator != 0 ? split_denominator / split_numerator : na

var float cumulative_adjustment = 1.0
if enable_split_adjustment and not na(split_ratio) and barstate.isnew
    cumulative_adjustment *= split_ratio

f_cum_adj_daily() =>
    sn = request.splits(syminfo.tickerid, splits.numerator, barmerge.gaps_on, ignore_invalid_symbol=true)
    sd = request.splits(syminfo.tickerid, splits.denominator, barmerge.gaps_on, ignore_invalid_symbol=true)
    r  = not na(sn) and not na(sd) and sn != 0 ? sd / sn : na
    var float cum = 1.0
    if enable_split_adjustment and not na(r) and barstate.isnew
        cum *= r
    cum

f_base_from_daily_agg() =>
    array<float> aShort = request.security_lower_tf(short_ticker, "1D", open, ignore_invalid_symbol=true)
    array<float> aPrice = request.security_lower_tf(syminfo.tickerid, "1D", f_price())
    array<float> aAdj   = request.security_lower_tf(syminfo.tickerid, "1D", f_cum_adj_daily())

    float out = na
    int validCount = 0

    int n = array.size(aShort)
    n := math.min(n, array.size(aPrice))
    n := math.min(n, array.size(aAdj))

    if n > 0
        out := 0.0
        for i = 0 to n - 1
            sv  = array.get(aShort, i)
            p   = array.get(aPrice, i)
            adj = array.get(aAdj, i)

            if not na(sv) and not na(p)
                float svAdj = enable_split_adjustment ? (sv * adj) : sv
                float shortValueDaily = svAdj * p
                out += shortValueDaily
                validCount += 1

    validCount > 0 ? out : na

shortVol_tf = request.security(short_ticker, timeframe.period, open, gaps=barmerge.gaps_on, ignore_invalid_symbol=true)
adjustedShortVol_tf = enable_split_adjustment ? shortVol_tf * cumulative_adjustment : shortVol_tf
shortValue_tf = adjustedShortVol_tf * priceSrc

baseInstant_tf = shortValue_tf

baseInstantRaw = useDailyAgg ? f_base_from_daily_agg() : baseInstant_tf

baseRolling = math.sum(baseInstantRaw, rollLen)
base = preSmoothLength > 1 ? ta.sma(baseRolling, preSmoothLength) : baseRolling

lowest_  = ta.lowest(base, lookback)
highest_ = ta.highest(base, lookback)

osc = oscType == "Percentile Rank" ? ta.percentrank(base, lookback) :
      oscType == "Stoch Range"     ? (highest_ != lowest_ ? 100.0 * (base - lowest_) / (highest_ - lowest_) : na) :
      na

signal = switch signalType
    "SMA" => ta.sma(osc, signalLength)
    "EMA" => ta.ema(osc, signalLength)
    => na

h100 = hline(100, "100", color=color.new(color.gray, 100))
h90  = hline(upperExtreme, "Extreme Overheat", color=color.new(color.red, 0), linestyle=hline.style_dashed)
h70  = hline(upperLevel, "Overheat", color=color.red, linestyle=hline.style_dotted)
h50  = hline(50, "Midline", color=color.gray, linestyle=hline.style_dotted)
h30  = hline(lowerLevel, "Shrinkage", color=color.aqua, linestyle=hline.style_dotted)
h10  = hline(lowerExtreme, "Extreme Shrinkage", color=color.new(color.aqua, 0), linestyle=hline.style_dashed)
h0   = hline(0, "0", color=color.new(color.gray, 100))

fill(h100, h90, color.new(color.red, 88), title="Extreme Overheat Zone")
fill(h90, h70, color.new(color.orange, 90), title="Overheat Zone")
fill(h30, h10, color.new(color.teal, 90), title="Shrinkage Zone")
fill(h10, h0, color.new(color.aqua, 88), title="Extreme Shrinkage Zone")

oscColor = osc >= upperExtreme ? color.red :
           osc >= upperLevel   ? color.orange :
           osc <= lowerExtreme ? color.aqua :
           osc <= lowerLevel   ? color.teal :
           color.silver

plot(osc, title="Rolling Short Pressure Oscillator", color=oscColor, linewidth=2)
plot(signal, title="Signal", color=color.yellow, linewidth=1)
plot(osc, title="Rolling Short Pressure Oscillator Value", color=color.new(color.white, 100), linewidth=1)

bgcolor(osc >= upperExtreme ? color.new(color.red, 93) :
       osc <= lowerExtreme ? color.new(color.aqua, 93) : na)

plot(baseInstantRaw, title="Base Instant", color=color.new(color.blue, 100), display=display.data_window)
plot(baseRolling, title="Base Rolling Sum", color=color.new(color.green, 100), display=display.data_window)
plot(base, title="Base Final", color=color.new(color.purple, 100), display=display.data_window)

alertcondition(ta.crossover(osc, upperLevel), "Enter Overheat", "Rolling short pressure oscillator crossed above Overheat.")
alertcondition(ta.crossover(osc, upperExtreme), "Enter Extreme Overheat", "Rolling short pressure oscillator crossed above Extreme Overheat.")
alertcondition(ta.crossunder(osc, lowerLevel), "Enter Shrinkage", "Rolling short pressure oscillator crossed below Shrinkage.")
alertcondition(ta.crossunder(osc, lowerExtreme), "Enter Extreme Shrinkage", "Rolling short pressure oscillator crossed below Extreme Shrinkage.")
