{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "key_takeaways",
    "report_title",
    "page1",
    "page2",
    "page3",
    "page4",
    "notes",
    "error"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "error"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "key_takeaways": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "report_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "page1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "lead", "facts", "left", "right"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "lead": { "type": "string", "minLength": 1, "maxLength": 420 },
        "facts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value", "note"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "value": { "type": "string", "minLength": 1, "maxLength": 90 },
              "note": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        },
        "left": { "$ref": "#/$defs/sectionCard" },
        "right": { "$ref": "#/$defs/sectionCard" }
      }
    },
    "page2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "matrix_cards", "table_rows", "warning_cards"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "matrix_cards": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/matrixCard" }
        },
        "table_rows": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/narrativeTableRow" }
        },
        "warning_cards": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/compactCard" }
        }
      }
    },
    "page3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "lead", "long_candidates", "short_watch_candidates"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "lead": { "type": "string", "minLength": 1, "maxLength": 260 },
        "long_candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/candidateCard" }
        },
        "short_watch_candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/candidateCard" }
        }
      }
    },
    "page4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "lead", "buckets", "footnote"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "lead": { "type": "string", "minLength": 1, "maxLength": 260 },
        "buckets": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/portfolioBucket" }
        },
        "footnote": { "type": "string", "minLength": 1, "maxLength": 260 }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "sectionCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "bullets"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "bullets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          }
        }
      }
    },
    "matrixCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "tags"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "body": { "type": "string", "minLength": 1, "maxLength": 220 },
        "tags": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    },
    "narrativeTableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focus", "change", "underpriced", "extend", "invalidate"],
      "properties": {
        "focus": { "type": "string", "minLength": 1, "maxLength": 80 },
        "change": { "type": "string", "minLength": 1, "maxLength": 180 },
        "underpriced": { "type": "string", "minLength": 1, "maxLength": 180 },
        "extend": { "type": "string", "minLength": 1, "maxLength": 160 },
        "invalidate": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "compactCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "body": { "type": "string", "minLength": 1, "maxLength": 180 }
      }
    },
    "candidateCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "ticker", "price", "short_term", "medium_term", "long_term", "asymmetry", "tags"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 10 },
        "ticker": { "type": "string", "minLength": 1, "maxLength": 40 },
        "price": { "type": "string", "minLength": 1, "maxLength": 32 },
        "short_term": { "type": "string", "minLength": 1, "maxLength": 180 },
        "medium_term": { "type": "string", "minLength": 1, "maxLength": 180 },
        "long_term": { "type": "string", "minLength": 1, "maxLength": 180 },
        "asymmetry": { "type": "string", "minLength": 1, "maxLength": 220 },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    },
    "portfolioBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "title", "items"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 20 },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
